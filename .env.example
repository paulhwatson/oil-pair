# Copy to .env and fill in real values. .env is gitignored - never commit real secrets.
# Runs against IG's demo API unless the process is started with --live.

IG_DEMO_USERNAME=
IG_DEMO_PASSWORD=
IG_DEMO_API_KEY=
IG_DEMO_ACC_NUMBER=

# Only read when --live is passed on the command line. Kept in a separate
# IG_LIVE_* namespace from the demo vars above so a typo can't point one
# account's credentials at the other.
IG_LIVE_USERNAME=
IG_LIVE_PASSWORD=
IG_LIVE_API_KEY=
IG_LIVE_ACC_NUMBER=

# Optional: email a summary to yourself each time a pair trade fully closes
# (see oil_pair/notifications.py). Leave both unset to disable - the app
# runs exactly the same either way, just without the email.
#
# ICLOUD_SMTP_USERNAME is your full Apple ID / iCloud email address.
# ICLOUD_SMTP_APP_PASSWORD is NOT your Apple ID password - generate a
# dedicated app-specific password at https://appleid.apple.com under
# "Sign-In and Security" -> "App-Specific Passwords".
ICLOUD_SMTP_USERNAME=
ICLOUD_SMTP_APP_PASSWORD=
# Defaults to ICLOUD_SMTP_USERNAME if unset - set this instead if you want
# the notification to go to a different address than it's sent from.
TRADE_NOTIFY_TO=
