# Copy to .env and fill in real values. .env is gitignored - never commit real secrets.
# Runs against IG's demo API unless the process is started with --live.

IG_DEMO_USERNAME=
IG_DEMO_PASSWORD=
IG_DEMO_API_KEY=
IG_DEMO_ACC_NUMBER=

# Only read when --live is passed on the command line. Kept in a separate
# IG_LIVE_* namespace from the demo vars above so a typo can't point one
# account's credentials at the other.
IG_LIVE_USERNAME=
IG_LIVE_PASSWORD=
IG_LIVE_API_KEY=
IG_LIVE_ACC_NUMBER=

# Optional: email when a pair opens or closes, and when startup closes a leg
# orphaned while the app was down (see oil_pair/notify.py). Leave SMTP_HOST/
# SMTP_USERNAME/SMTP_PASSWORD/NOTIFY_EMAIL_TO unset to disable - the app runs
# exactly the same either way, just without the email. Works with any SMTP
# provider.
#
# For iCloud: SMTP_HOST=smtp.mail.me.com, SMTP_PORT=587, SMTP_USERNAME is
# your full Apple ID / iCloud email address, and SMTP_PASSWORD is NOT your
# Apple ID password - generate a dedicated app-specific password at
# https://appleid.apple.com under "Sign-In and Security" ->
# "App-Specific Passwords". Gmail: smtp.gmail.com, 587, with an app password.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
NOTIFY_EMAIL_TO=
# Defaults to SMTP_USERNAME.
NOTIFY_EMAIL_FROM=
